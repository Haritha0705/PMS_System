# Copy this file to server/.env, then replace the values marked with < >.
# Never commit server/.env or send it in a public place.

PORT=4500
NODE_ENV=development

# Ask the project owner for this privately. It gives full access to the real data.
DATABASE_URL=<paste the database connection here>

# Create each one with this command, and use a different value for each:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<paste a generated value here>
REFRESH_SECRET=<paste a different generated value here>

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4500

# Optional. Leave empty to keep the cache in memory.
REDIS_URL=

# Only used if the database has no admin yet. It does not change an existing admin.
ADMIN_INITIAL_PASSWORD=
